# EditorConfig keeps whitespace consistent across editors: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Every byte imported from ShadowScan is bound by MIGRATION.json (path, Git
# blob, mode, length and SHA-256), and .gitattributes marks the same trees
# -text. Editors must never normalize them; `python -m tools.verify_migration`
# fails on any change. Mirrors the exclusions of the pre-commit whitespace
# hooks (.pre-commit-config.yaml).
[benchmarks/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[tools/{benchmark,benchmark_realworld,discovery_benchmark,shadowbench}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[migration/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# The migration manifest, the hash locks and the retained licence texts.
[{MIGRATION.json,LICENSE,NOTICE,*.lock}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
